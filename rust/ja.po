msgid "Agama's command-line interface"
msgstr ""

#. TRANSLATORS: command: agama (details)
#: agama-cli/src/cli_strings.rs:6
msgid ""
"This program allows inspecting or changing Agama's configuration, handling "
"installation profiles, starting the installation, monitoring the process, "
"etc.\n"
"\n"
"Please, use the \"help\" command to learn more."
msgstr ""

#. TRANSLATORS: command: agama --host <HOST>
#: agama-cli/src/cli_strings.rs:8
msgid "URI pointing to Agama's remote host"
msgstr ""

#. TRANSLATORS: command: agama --host <HOST> (details)
#: agama-cli/src/cli_strings.rs:10
msgid "Examples: https://my-server.lan my-server.local localhost:10443"
msgstr ""

