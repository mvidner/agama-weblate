#: agama-cli/src/cli_strings.rs:30
msgid "Validate a profile using JSON Schema"
msgstr ""

#. TRANSLATORS: command: agama config validate (details)
#: agama-cli/src/cli_strings.rs:32
msgid ""
"Schema is available at /usr/share/agama/schema/profile.schema.json Note: "
"validation is always done as part of all other \"agama config\" commands."
msgstr ""

#. TRANSLATORS: command: agama config validate <URL_OR_PATH>
#: agama-cli/src/cli_strings.rs:34
